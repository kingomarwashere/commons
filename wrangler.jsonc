{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commons",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "commons.theradicalparty.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROUTER", "class_name": "Router" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Router"] }
  ],
  "vars": {
    "PUBLIC_NAME": "Radical Commons"
  }
  // Secrets (set with `wrangler secret put`):
  //   ADMIN_TOKEN   — required for /admin/* and pool management
  //   DONATE_TOKEN  — optional shared secret to gate /donate (else open)
}
